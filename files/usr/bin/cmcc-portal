#!/bin/sh

# 江苏移动 wlan.jsyd139.com Captive Portal 自动认证
# luci-app-cmcc-portal backend

TAG="cmcc-portal"
PORTAL_HOST="http://wlan.jsyd139.com"
AUTH_URL="${PORTAL_HOST}/authServlet"

COOKIE="/tmp/cmcc-portal.cookie"
PAGE="/tmp/cmcc-portal.html"
FRAME_PAGE="/tmp/cmcc-frame.html"
RESPONSE="/tmp/cmcc-login-response.html"
HEADERS="/tmp/cmcc-login-headers.txt"
STATUS_FILE="/tmp/cmcc-portal.status"
LOCK_DIR="/tmp/cmcc-portal.lock"

UA="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/151.0.0.0 Safari/537.36"

uci_get() {
	uci -q get "cmcc_portal.main.$1" 2>/dev/null
}

load_config() {
	ENABLED="$(uci_get enabled)"
	LOGIN_MODE="$(uci_get login_mode)"
	USERNAME="$(uci_get username)"
	PASSWORD="$(uci_get password)"
	REMEMBER_COOKIE="$(uci_get remember_cookie)"
	INTERVAL="$(uci_get interval)"
	TRIGGER_URL="$(uci_get trigger_url)"
	CHECK_URL="$(uci_get check_url)"

	[ -n "$LOGIN_MODE" ] || LOGIN_MODE="cookie"
	[ -n "$INTERVAL" ] || INTERVAL="60"
	[ -n "$TRIGGER_URL" ] || TRIGGER_URL="http://www.baidu.com/"
	[ -n "$CHECK_URL" ] || CHECK_URL="https://www.baidu.com/"

	case "$INTERVAL" in
		*[!0-9]*|'') INTERVAL=60 ;;
	esac
	[ "$INTERVAL" -ge 15 ] 2>/dev/null || INTERVAL=15
}

log() {
	logger -t "$TAG" -- "$*"
	printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"
}

set_status() {
	STATE="$1"
	shift
	MSG="$*"
	{
		printf 'state=%s\n' "$STATE"
		printf 'time=%s\n' "$(date '+%Y-%m-%d %H:%M:%S')"
		printf 'message=%s\n' "$MSG"
	} > "$STATUS_FILE"
}

wan_ip() {
	if command -v ubus >/dev/null 2>&1 && command -v jsonfilter >/dev/null 2>&1; then
		ubus call network.interface.wan status 2>/dev/null | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null
	fi
}

check_online() {
	load_config
	CODE="$(curl -k -sS --connect-timeout 5 --max-time 8 -o /dev/null -w '%{http_code}' "$CHECK_URL" 2>/dev/null)"
	case "$CODE" in
		200|204|301|302) return 0 ;;
		*) return 1 ;;
	esac
}

cookie_value() {
	NAME="$1"
	printf '%s' "$REMEMBER_COOKIE" | tr ';' '\n' | sed -n "s/^[[:space:]]*${NAME}=//p" | head -n 1
}

add_cookie() {
	NAME="$1"
	VALUE="$2"
	printf 'wlan.jsyd139.com\tFALSE\t/\tFALSE\t0\t%s\t%s\n' "$NAME" "$VALUE" >> "$COOKIE"
}

lock_acquire() {
	if mkdir "$LOCK_DIR" 2>/dev/null; then
		trap 'rmdir "$LOCK_DIR" 2>/dev/null' EXIT INT TERM
		return 0
	fi
	return 1
}

login_portal() {
	load_config

	[ -n "$USERNAME" ] || { set_status error "未配置用户名"; log "错误：未配置用户名"; return 10; }
	[ -n "$PASSWORD" ] || { set_status error "未配置密码"; log "错误：未配置密码"; return 11; }

	if check_online; then
		set_status online "网络已经认证"
		log "网络已经认证，无需重新登录。"
		return 0
	fi

	lock_acquire || { log "已有认证任务正在运行，跳过本次。"; return 0; }

	set_status authenticating "正在获取 Portal"
	log "检测到网络未认证，开始获取 Portal。"

	rm -f "$COOKIE" "$PAGE" "$FRAME_PAGE" "$RESPONSE" "$HEADERS"

	FINAL_URL="$(
		curl -sS -L \
			--connect-timeout 5 --max-time 20 \
			-A "$UA" \
			-c "$COOKIE" -b "$COOKIE" \
			-o "$PAGE" \
			-w '%{url_effective}' \
			"$TRIGGER_URL" 2>/dev/null
	)"

	[ -n "$FINAL_URL" ] || { set_status error "无法触发 Portal"; log "错误：无法触发 Portal。"; return 20; }
	log "Portal 最终地址：$FINAL_URL"

	case "$FINAL_URL" in
		*wlan.jsyd139.com*) ;;
		*)
			if check_online; then
				set_status online "网络已经可以正常访问互联网"
				log "网络已经可以正常访问互联网。"
				return 0
			fi
			set_status error "未进入江苏移动 Portal"
			log "错误：未进入江苏移动 Portal：$FINAL_URL"
			return 21
		;;
	esac

	FRAME_PATH="$(sed -n 's/.*<frame[^>]*src="\([^"]*index\.jsp?paramStr=[^"]*\)".*/\1/p' "$PAGE" | head -n 1)"
	if [ -z "$FRAME_PATH" ]; then
		FRAME_PATH="$(grep -o 'style/[^"]*index.jsp?paramStr=[^"]*' "$PAGE" 2>/dev/null | head -n 1)"
	fi

	[ -n "$FRAME_PATH" ] || { set_status error "未找到认证页面"; log "错误：没有找到 index.jsp 认证页面。"; return 22; }

	case "$FRAME_PATH" in
		http://*|https://*) FRAME_URL="$FRAME_PATH" ;;
		/*) FRAME_URL="${PORTAL_HOST}${FRAME_PATH}" ;;
		*) FRAME_URL="${PORTAL_HOST}/${FRAME_PATH}" ;;
	esac

	log "认证页面：$FRAME_URL"
	set_status authenticating "正在初始化 Portal 会话"

	curl -sS \
		--connect-timeout 5 --max-time 20 \
		-A "$UA" \
		-b "$COOKIE" -c "$COOKIE" \
		-e "$FINAL_URL" \
		"$FRAME_URL" \
		-o "$FRAME_PAGE" || {
			set_status error "认证页面加载失败"
			log "错误：认证页面加载失败。"
			return 23
		}

	[ -s "$FRAME_PAGE" ] || { set_status error "认证页面为空"; log "错误：认证页面为空。"; return 24; }
	log "Portal 会话初始化完成。"

	PARAMSTR="$(sed -n 's/.*name="paramStr"[^>]*value="\([^"]*\)".*/\1/p' "$FRAME_PAGE" | head -n 1)"
	[ -n "$PARAMSTR" ] || PARAMSTR="$(sed -n 's/.*id="paramStr"[^>]*value="\([^"]*\)".*/\1/p' "$FRAME_PAGE" | head -n 1)"
	[ -n "$PARAMSTR" ] || { set_status error "无法获取动态 paramStr"; log "错误：无法从登录页面获取 paramStr。"; return 25; }
	log "成功获取动态 paramStr。"

	case "$LOGIN_MODE" in
		cookie)
			COOKIE_USERNAME="$(cookie_value UserName)"
			COOKIE_PROVINCE="$(cookie_value province)"
			COOKIE_USERTYPE="$(cookie_value UserType)"
			COOKIE_PASSWORD="$(cookie_value PassWord)"

			[ -n "$COOKIE_USERNAME" ] || { set_status error "记住密码 Cookie 缺少 UserName"; log "错误：记住密码 Cookie 缺少 UserName。"; return 30; }
			[ -n "$COOKIE_PROVINCE" ] || { set_status error "记住密码 Cookie 缺少 province"; log "错误：记住密码 Cookie 缺少 province。"; return 31; }
			[ -n "$COOKIE_USERTYPE" ] || { set_status error "记住密码 Cookie 缺少 UserType"; log "错误：记住密码 Cookie 缺少 UserType。"; return 32; }
			[ -n "$COOKIE_PASSWORD" ] || { set_status error "记住密码 Cookie 缺少 PassWord"; log "错误：记住密码 Cookie 缺少 PassWord。"; return 33; }

			add_cookie UserName "$COOKIE_USERNAME"
			add_cookie province "$COOKIE_PROVINCE"
			add_cookie UserType "$COOKIE_USERTYPE"
			add_cookie PassWord "$COOKIE_PASSWORD"
			log "已加载记住密码 Cookie。"

			IS_COOKIE=true
			COOKIE_TYPE=2
			COOKIE_ARG="--data-urlencode cookie=2"
		;;
		plain|*)
			IS_COOKIE=false
			COOKIE_TYPE=-1
			COOKIE_ARG=""
		;;
	esac

	set_status authenticating "正在提交账号认证"
	log "正在提交账号认证……"

	HTTP_CODE="$(
		curl -sS -L \
			--connect-timeout 5 --max-time 25 \
			-A "$UA" \
			-b "$COOKIE" -c "$COOKIE" \
			-e "$FRAME_URL" \
			-H 'Accept: text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8' \
			-H 'Accept-Language: zh-CN,zh-TW;q=0.9,zh;q=0.8' \
			-H 'Cache-Control: max-age=0' \
			-H 'Content-Type: application/x-www-form-urlencoded' \
			-H 'Origin: http://wlan.jsyd139.com' \
			-H 'Upgrade-Insecure-Requests: 1' \
			-D "$HEADERS" \
			-o "$RESPONSE" \
			-w '%{http_code}' \
			--data-urlencode "paramStr=$PARAMSTR" \
			--data-urlencode 'UserType=' \
			--data-urlencode 'province=' \
			--data-urlencode 'pwdType=1' \
			--data-urlencode 'serviceType=301' \
			--data-urlencode "isCookie=$IS_COOKIE" \
			--data-urlencode 'province=' \
			--data-urlencode "cookieType=$COOKIE_TYPE" \
			--data-urlencode "UserName=$USERNAME" \
			--data-urlencode "PassWord=$PASSWORD" \
			$COOKIE_ARG \
			"$AUTH_URL" 2>/dev/null
	)"
	CURL_RC=$?

	[ "$CURL_RC" -eq 0 ] || { set_status error "curl 提交认证失败($CURL_RC)"; log "错误：curl 提交认证失败，代码 $CURL_RC。"; return 40; }
	log "认证服务器最终 HTTP 状态码：$HTTP_CODE"

	if grep -qi 'login_fail.jsp' "$HEADERS" 2>/dev/null; then
		set_status failed "Portal 明确返回登录失败"
		log "Portal 明确返回登录失败。"
		return 41
	fi

	i=1
	while [ "$i" -le 5 ]; do
		sleep 3
		if check_online; then
			set_status online "Portal 认证成功，互联网已经放行"
			log "中国移动 Portal 认证成功，互联网已经正常放行。"
			return 0
		fi
		i=$((i + 1))
	done

	set_status failed "认证请求完成，但互联网仍未放行"
	log "认证请求已完成，但互联网仍未放行。"
	return 42
}

print_status() {
	if check_online; then
		STATE="在线（已认证）"
	else
		STATE="离线 / 未认证"
	fi
	IP="$(wan_ip)"
	[ -n "$IP" ] || IP="未知"
	printf '当前状态：%s\n' "$STATE"
	printf 'WAN IPv4：%s\n' "$IP"
	if [ -f "$STATUS_FILE" ]; then
		LAST_TIME="$(sed -n 's/^time=//p' "$STATUS_FILE" | head -n1)"
		LAST_MSG="$(sed -n 's/^message=//p' "$STATUS_FILE" | head -n1)"
		[ -n "$LAST_TIME" ] && printf '最近时间：%s\n' "$LAST_TIME"
		[ -n "$LAST_MSG" ] && printf '最近结果：%s\n' "$LAST_MSG"
	fi
}

watch_loop() {
	log "自动认证守护进程已启动。"
	while true; do
		load_config
		if [ "$ENABLED" = "1" ]; then
			if ! check_online; then
				login_portal >/dev/null 2>&1
			fi
		fi
		sleep "$INTERVAL"
	done
}

case "$1" in
	login|once)
		login_portal
	;;
	check)
		if check_online; then
			set_status online "网络已认证"
			print_status
			exit 0
		else
			set_status offline "网络未认证"
			print_status
			exit 1
		fi
	;;
	status)
		print_status
	;;
	watch)
		watch_loop
	;;
	logs)
		logread -e cmcc-portal 2>/dev/null | tail -n 120
	;;
	restart)
		/etc/init.d/cmcc-portal restart >/dev/null 2>&1
		echo "守护进程已重启。"
	;;
	*)
		echo "Usage: $0 {login|check|status|watch|logs|restart}"
		exit 1
	;;
esac
